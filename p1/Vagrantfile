# frozen_string_literal: true

require "fileutils"
require "securerandom"

LOGIN = ENV.fetch("IOT_LOGIN", "tmoragli")
BOX = ENV.fetch("IOT_BOX", "bento/ubuntu-26.04")
SERVER_IP = "192.168.56.110"
AGENT_IP = "192.168.56.111"

unless LOGIN.match?(/\A[a-z0-9-]+\z/)
	abort "IOT_LOGIN must contain only lowercase letters, digits, and hyphens"
end

token_path = File.join(__dir__, ".vagrant", "k3s-token")
FileUtils.mkdir_p(File.dirname(token_path))
unless File.exist?(token_path)
	File.write(token_path, SecureRandom.hex(32))
	File.chmod(0o600, token_path)
end
cluster_token = File.read(token_path).strip

Vagrant.configure("2") do |config|
	config.vm.box = BOX
	config.vm.box_check_update = true
	config.vm.boot_timeout = 1200
	config.ssh.insert_key = true
	config.vm.synced_folder ".", "/vagrant", disabled: true

	config.vm.provider "virtualbox" do |virtualbox|
		# Running nested (VirtualBox inside a VM) on a hybrid P-core/E-core Intel CPU,
		# the guest's kvm-clock/TSC reads garbage and the kernel hangs early in boot.
		# Disable the paravirt clock and have VirtualBox emulate the TSC instead.
		virtualbox.customize ["modifyvm", :id, "--paravirtprovider", "none"]
		virtualbox.customize ["setextradata", :id, "VBoxInternal/TM/TSCMode", "VirtTSCEmulated"]
	end

	config.vm.provider "libvirt" do |libvirt|
		# Name the libvirt domains <login>S/<login>SW instead of "<dir>_<login>S".
		libvirt.default_prefix = ""
		libvirt.driver = "kvm"
		libvirt.cpu_mode = "host-passthrough"
		# The bento box is UEFI-only (GPT + EFI partition, no BIOS boot code), so the
		# default SeaBIOS spins forever on "Booting from Hard Disk...". libvirt creates
		# each domain's NVRAM file from the matching OVMF_VARS template on first boot.
		libvirt.loader = "/usr/share/OVMF/OVMF_CODE_4M.fd"
	end

	server_name = "#{LOGIN}S"
	agent_name = "#{LOGIN}SW"
	server_cpus = Integer(ENV.fetch("IOT_SERVER_CPUS", "1"))
	server_memory = Integer(ENV.fetch("IOT_SERVER_MEMORY", "2048"))
	agent_cpus = Integer(ENV.fetch("IOT_AGENT_CPUS", "1"))
	agent_memory = Integer(ENV.fetch("IOT_AGENT_MEMORY", "1024"))

	config.vm.define server_name, primary: true do |server|
		server.vm.hostname = server_name
		server.vm.network "private_network", ip: SERVER_IP

		server.vm.provider "virtualbox" do |virtualbox|
			virtualbox.name = server_name
			virtualbox.gui = false
			virtualbox.cpus = server_cpus
			virtualbox.memory = server_memory
		end

		server.vm.provider "libvirt" do |libvirt|
			libvirt.cpus = server_cpus
			libvirt.memory = server_memory
			libvirt.nvram = "/var/lib/libvirt/qemu/nvram/#{server_name}_VARS.fd"
		end

		server.vm.provision "shell",
			path: "scripts/install-server.sh",
			env: {
				"K3S_TOKEN" => cluster_token,
				"NODE_IP" => SERVER_IP,
				"K3S_NODE_NAME" => server_name.downcase
			}
	end

	config.vm.define agent_name do |agent|
		agent.vm.hostname = agent_name
		agent.vm.network "private_network", ip: AGENT_IP

		agent.vm.provider "virtualbox" do |virtualbox|
			virtualbox.name = agent_name
			virtualbox.gui = false
			virtualbox.cpus = agent_cpus
			virtualbox.memory = agent_memory
		end

		agent.vm.provider "libvirt" do |libvirt|
			libvirt.cpus = agent_cpus
			libvirt.memory = agent_memory
			libvirt.nvram = "/var/lib/libvirt/qemu/nvram/#{agent_name}_VARS.fd"
		end

		agent.vm.provision "shell",
			path: "scripts/install-agent.sh",
			env: {
				"K3S_TOKEN" => cluster_token,
				"NODE_IP" => AGENT_IP,
				"SERVER_IP" => SERVER_IP,
				"K3S_NODE_NAME" => agent_name.downcase
			}
	end
end
